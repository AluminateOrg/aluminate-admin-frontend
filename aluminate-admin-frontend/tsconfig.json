{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["app/*"],
      "lib/*": ["lib/*"],
      "types/*": ["types/*"]
    }
  },
  "include": ["app/**/*", "lib/**/*", "types/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}